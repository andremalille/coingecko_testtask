# Optional CoinGecko Demo API key (recommended to avoid aggressive rate limiting)
COINGECKO_API_KEY=
# Base URL: use https://pro-api.coingecko.com/api/v3 for a paid key
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
# Number of /coins/markets pages to scan (250 coins per page, ordered by market cap)
MAX_MARKET_PAGES=1
# Max concurrent requests to the /coins/{id} detail endpoint
DETAIL_CONCURRENCY=3
# How long (seconds) the filtered result is cached in memory
CACHE_TTL_SECONDS=300
# Allowed CORS origins, comma separated
CORS_ORIGINS=http://localhost:5173